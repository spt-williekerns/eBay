+/**
+ * Server Time Sync - Prevents client clock drift from corrupting countdowns
+ * Sync once on app load via HEAD /api/ping, then use offset for all timers
+ */
+
+let serverOffset = 0; // milliseconds: server - client
+
+export const syncServerTime = async (): Promise<void> => {
+  try {
+    const reqTime = Date.now();
+    const res = await fetch('/api/ping', { method: 'HEAD' });
+    const serverTime = new Date(res.headers.get('Date') || '').getTime();
+    const rtt = Date.now() - reqTime;
+    serverOffset = serverTime - reqTime - rtt / 2; // Adjust for round-trip
+  } catch (err) {
+    console.warn('Server time sync failed, using local time', err);
+  }
+};
+
+export const getServerTime = (): number => {
+  return Date.now() + serverOffset;
+};
