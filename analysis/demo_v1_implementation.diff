+/**
+ * Toast Notification Component
+ *
+ * Accessible notifications with aria-live for screen readers
+ */
+
+import React, { useEffect } from 'react';
+import { View, Text, StyleSheet } from 'react-native';
+import * as Animatable from 'react-native-animatable';
+import { KentuckyLakeTheme } from '../../theme/colors';
+import { Spacing } from '../../theme/spacing';
+
+export type ToastType = 'success' | 'error' | 'info' | 'warning';
+
+interface ToastProps {
+  message: string;
+  type: ToastType;
+  duration?: number;
+  onDismiss: () => void;
+}
+
+export const Toast: React.FC<ToastProps> = ({
+  message,
+  type,
+  duration = 4000,
+  onDismiss,
+}) => {
+  useEffect(() => {
+    const timer = setTimeout(onDismiss, duration);
+    return () => clearTimeout(timer);
+  }, [duration, onDismiss]);
+
+  const getBackgroundColor = () => {
+    switch (type) {
+      case 'success': return KentuckyLakeTheme.success;
+      case 'error': return KentuckyLakeTheme.error;
+      case 'warning': return KentuckyLakeTheme.warning;
+      case 'info': return KentuckyLakeTheme.info;
+      default: return KentuckyLakeTheme.lakeBlue;
+    }
+  };
+
+  const getIcon = () => {
+    switch (type) {
+      case 'success': return '✓';
+      case 'error': return '✕';
+      case 'warning': return '⚠';
+      case 'info': return 'ℹ';
+      default: return '';
+    }
+  };
+
+  return (
+    <Animatable.View
+      animation="slideInDown"
+      duration={300}
+      style={[styles.container, { backgroundColor: getBackgroundColor() }]}
+      role="alert"
+      aria-live="polite"
+      accessibilityLiveRegion="polite"
+    >
+      <Text style={styles.icon}>{getIcon()}</Text>
+      <Text style={styles.message}>{message}</Text>
+    </Animatable.View>
+  );
+};
+
+const styles = StyleSheet.create({
+  container: {
+    position: 'absolute',
+    top: 60,
+    left: Spacing.md,
+    right: Spacing.md,
+    padding: Spacing.md,
+    borderRadius: 12,
+    flexDirection: 'row',
+    alignItems: 'center',
+    zIndex: 9999,
+    shadowColor: '#000',
+    shadowOffset: { width: 0, height: 4 },
+    shadowOpacity: 0.3,
+    shadowRadius: 8,
+    elevation: 10,
+  },
+  icon: { fontSize: 36, color: KentuckyLakeTheme.white, marginRight: Spacing.sm },
+  message: { fontSize: 32, fontWeight: '600', color: KentuckyLakeTheme.white, flex: 1 },
+});
