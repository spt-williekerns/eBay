+/**
+ * Registration Screen - First-Run Onboarding
+ *
+ * Generates bidder ID and collects basic info
+ */
+
+import React, { useState } from 'react';
+import { View, Text, TextInput, StyleSheet, TouchableOpacity, Modal, ScrollView } from 'react-native';
+import { useAppDispatch } from '../store';
+import { setUser } from '../store/slices/userSlice';
+import { KentuckyLakeTheme } from '../theme/colors';
+import { TextStyles } from '../theme/typography';
+import { Spacing } from '../theme/spacing';
+import { v4 as uuid } from 'uuid';
+
+interface RegistrationScreenProps {
+  visible: boolean;
+  onComplete: () => void;
+}
+
+export const RegistrationScreen: React.FC<RegistrationScreenProps> = ({ visible, onComplete }) => {
+  const dispatch = useAppDispatch();
+  const [name, setName] = useState('');
+  const [email, setEmail] = useState('');
+  const [town, setTown] = useState('Benton, KY');
+  const [error, setError] = useState('');
+
+  const generateBidderId = (): string => {
+    const prefix = 'KC';
+    const number = Math.floor(10000 + Math.random() * 90000);
+    return `${prefix}-${number}`;
+  };
+
+  const handleRegister = () => {
+    if (!name.trim()) {
+      setError('Please enter your name');
+      return;
+    }
+    if (!email.trim() || !email.includes('@')) {
+      setError('Please enter a valid email');
+      return;
+    }
+
+    const user = {
+      id: uuid(),
+      bidderId: generateBidderId(),
+      name: name.trim(),
+      email: email.trim(),
+      town: town.trim() || 'Benton, KY',
+      phone: '',
+      totalWins: 0,
+      totalBids: 0,
+      memberSince: new Date().toISOString(),
+    };
+
+    dispatch(setUser(user));
+    onComplete();
+  };
+
+  return (
+    <Modal visible={visible} animationType="slide" transparent={false}>
+      <ScrollView style={styles.container}>
+        <View style={styles.content}>
+          <Text style={styles.title}>Welcome to Marshall County Auction!</Text>
+          <Text style={styles.subtitle}>Create your bidder account to get started</Text>
+
+          {error ? (
+            <View style={styles.errorBox} role="alert" aria-live="polite">
+              <Text style={styles.errorText}>⚠ {error}</Text>
+            </View>
+          ) : null}
+
+          <View style={styles.inputGroup}>
+            <Text style={styles.label}>Your Name *</Text>
+            <TextInput
+              style={styles.input}
+              value={name}
+              onChangeText={(text) => { setName(text); setError(''); }}
+              placeholder="John Smith"
+              placeholderTextColor={KentuckyLakeTheme.damGray}
+              accessibilityLabel="Your name"
+              autoCapitalize="words"
+            />
+          </View>
+
+          <View style={styles.inputGroup}>
+            <Text style={styles.label}>Email Address *</Text>
+            <TextInput
+              style={styles.input}
+              value={email}
+              onChangeText={(text) => { setEmail(text); setError(''); }}
+              placeholder="john@example.com"
+              placeholderTextColor={KentuckyLakeTheme.damGray}
+              keyboardType="email-address"
+              autoCapitalize="none"
+              accessibilityLabel="Email address"
+            />
+          </View>
+
+          <View style={styles.inputGroup}>
+            <Text style={styles.label}>Town (Kentucky)</Text>
+            <TextInput
+              style={styles.input}
+              value={town}
+              onChangeText={setTown}
+              placeholder="Benton, KY"
+              placeholderTextColor={KentuckyLakeTheme.damGray}
+              accessibilityLabel="Town"
+            />
+          </View>
+
+          <TouchableOpacity
+            style={styles.button}
+            onPress={handleRegister}
+            accessibilityRole="button"
+            accessibilityLabel="Create my account"
+          >
+            <Text style={styles.buttonText}>Create My Account</Text>
+          </TouchableOpacity>
+
+          <Text style={styles.note}>
+            You'll receive your Bidder Number after registration
+          </Text>
+        </View>
+      </ScrollView>
+    </Modal>
+  );
