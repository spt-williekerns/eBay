@@ -0,0 +1,98 @@
+/**
+ * Auction Timer
+ * 
+ * Background task to close auctions and determine winners
+ */
+
+import { store } from '../store';
+import { updateLotStatus } from '../store/slices/auctionSlice';
+import { updateBidStatus } from '../store/slices/bidSlice';
+
+let timerInterval: NodeJS.Timeout | null = null;
+
+/**
+ * Start the auction timer
+ * Checks every 10 seconds for auctions that need to close
+ */
+export function startAuctionTimer(): void {
+  if (timerInterval) {
+    console.warn('Auction timer already running');
+    return;
+  }
+
+  console.log('[AuctionTimer] Starting...');
+  
+  // Run immediately, then every 10 seconds
+  checkAndCloseAuctions();
+  timerInterval = setInterval(checkAndCloseAuctions, 10000);
+}
+
+/**
+ * Stop the auction timer
+ */
+export function stopAuctionTimer(): void {
+  if (timerInterval) {
+    clearInterval(timerInterval);
+    timerInterval = null;
+    console.log('[AuctionTimer] Stopped');
+  }
+}
+
+/**
+ * Check all lots and close those that have ended
+ */
+function checkAndCloseAuctions(): void {
+  const state = store.getState();
+  const { lots } = state.auction;
+  const { userBids } = state.bid;
+  const now = new Date();
+
+  lots.forEach((lot) => {
+    const endTime = new Date(lot.endTime);
+
+    // Skip if already closed
+    if (lot.status === 'closed') return;
+
+    // Check if auction has ended
+    if (now >= endTime) {
+      console.log(`[AuctionTimer] Closing lot ${lot.id}: ${lot.title}`);
+
+      // Update lot status to closed
+      store.dispatch(
+        updateLotStatus({
+          lotId: lot.id,
+          status: 'closed',
+        })
+      );
+
+      // Determine winner
+      const lotsWithBids = userBids.filter((bid) => bid.lotId === lot.id);
+      
+      if (lotsWithBids.length === 0) {
+        console.log(`[AuctionTimer] No bids for lot ${lot.id}`);
+        return;
+      }
+
+      // Sort by amount (highest first), then by timestamp (earliest first)
+      const sortedBids = lotsWithBids.sort((a, b) => {
+        if (a.amount !== b.amount) {
+          return b.amount - a.amount; // Descending by amount
+        }
+        return new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime(); // Ascending by time
+      });
+
+      const winningBid = sortedBids[0];
+      const losingBids = sortedBids.slice(1);
+
+      // Update bid statuses
+      store.dispatch(updateBidStatus({ bidId: winningBid.id, status: 'won' }));
+      
+      losingBids.forEach((bid) => {
+        store.dispatch(updateBidStatus({ bidId: bid.id, status: 'lost' }));
+      });
+
+      console.log(`[AuctionTimer] Winner: ${winningBid.userId} with $${winningBid.amount}`);
+    }
+  });
+}

